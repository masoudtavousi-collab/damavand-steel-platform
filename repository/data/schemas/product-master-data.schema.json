{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:damavand-steel:schema:product-master-data:1.0.0",
  "title": "PD-01 synthetic Product Master Data bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "bundle_id",
    "bundle_version",
    "data_classification",
    "product_core_contract_version",
    "product_attribute_contract_version",
    "measurement_contract_version",
    "attribute_profiles",
    "value_assignments",
    "variant_rule_sets",
    "readiness",
    "provenance"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^pmd:[0-9a-f]{12}$"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "data_classification": {
      "const": "SYNTHETIC_FIXTURE"
    },
    "product_core_contract_version": {
      "const": "1.0.0"
    },
    "product_attribute_contract_version": {
      "const": "2.0.0"
    },
    "measurement_contract_version": {
      "const": "1.0.0"
    },
    "attribute_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/attribute_profile"
      }
    },
    "value_assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/value_assignment"
      }
    },
    "variant_rule_sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/variant_rule_set"
      }
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "attribute_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "scope_entity_id",
        "scope_entity_type",
        "attribute_rules",
        "record_version"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^pprof:[0-9a-f]{12}$"
        },
        "scope_entity_id": {
          "type": "string",
          "pattern": "^prd:(family|series):[0-9a-f]{12}$"
        },
        "scope_entity_type": {
          "enum": [
            "FAMILY",
            "SERIES"
          ]
        },
        "attribute_rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/attribute_rule"
          }
        },
        "record_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "attribute_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribute_id",
        "requirement_level",
        "condition_reference",
        "public_visibility",
        "variation_axis",
        "filtering",
        "inquiry_use",
        "seo_use"
      ],
      "properties": {
        "attribute_id": {
          "type": "string",
          "pattern": "^attr:[0-9a-f]{12}$"
        },
        "requirement_level": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "CONDITIONAL",
            "PROHIBITED"
          ]
        },
        "condition_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "public_visibility": {
          "enum": [
            "PUBLIC",
            "PROTECTED",
            "INTERNAL",
            "INTEGRATION_ONLY"
          ]
        },
        "variation_axis": {
          "type": "boolean"
        },
        "filtering": {
          "type": "boolean"
        },
        "inquiry_use": {
          "enum": [
            "PREFILLED",
            "SELECTABLE",
            "FREE_REQUIREMENT",
            "NOT_USED"
          ]
        },
        "seo_use": {
          "enum": [
            "SUPPORTING",
            "LANDING_OWNER",
            "NON_INDEXABLE",
            "PROHIBITED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requirement_level": {
                "const": "CONDITIONAL"
              }
            },
            "required": [
              "requirement_level"
            ]
          },
          "then": {
            "properties": {
              "condition_reference": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "condition_reference": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "value_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "entity_id",
        "attribute_id",
        "value",
        "unit_id",
        "status",
        "provenance",
        "record_version"
      ],
      "properties": {
        "assignment_id": {
          "type": "string",
          "pattern": "^pval:[0-9a-f]{12}$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^prd:(catalog|platform|family|series|variant-rule-set):[0-9a-f]{12}$"
        },
        "attribute_id": {
          "type": "string",
          "pattern": "^attr:[0-9a-f]{12}$"
        },
        "value": {
          "$ref": "#/$defs/typed_value"
        },
        "unit_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^unit:[0-9a-f]{12}$"
        },
        "status": {
          "const": "CANDIDATE_UNVERIFIED"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "record_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "typed_value": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "integer": {
          "type": "integer"
        },
        "decimal": {
          "type": "number"
        },
        "boolean": {
          "type": "boolean"
        },
        "term_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[0-9a-f]{12}$"
        },
        "entity_reference": {
          "type": "string",
          "pattern": "^prd:(catalog|platform|family|series|variant-rule-set):[0-9a-f]{12}$"
        }
      }
    },
    "variant_rule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_set_entity_id",
        "profile_id",
        "axes",
        "cartesian_generation_forbidden",
        "allowed_combinations",
        "record_version"
      ],
      "properties": {
        "rule_set_entity_id": {
          "type": "string",
          "pattern": "^prd:variant-rule-set:[0-9a-f]{12}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^pprof:[0-9a-f]{12}$"
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^attr:[0-9a-f]{12}$"
          }
        },
        "cartesian_generation_forbidden": {
          "const": true
        },
        "allowed_combinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/allowed_combination"
          }
        },
        "record_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "allowed_combination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combination_id",
        "assignment_ids",
        "status"
      ],
      "properties": {
        "combination_id": {
          "type": "string",
          "pattern": "^pcomb:[0-9a-f]{12}$"
        },
        "assignment_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^pval:[0-9a-f]{12}$"
          }
        },
        "status": {
          "const": "CANDIDATE_UNVERIFIED"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_ready",
        "runtime_ready",
        "golden_ready"
      ],
      "properties": {
        "import_ready": {
          "const": false
        },
        "runtime_ready": {
          "const": false
        },
        "golden_ready": {
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_reference",
        "captured_by",
        "captured_at",
        "evidence_status"
      ],
      "properties": {
        "source_type": {
          "const": "SYNTHETIC_FIXTURE"
        },
        "source_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "captured_by": {
          "type": "string",
          "pattern": "^role:[a-z][a-z0-9-]{2,63}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "evidence_status": {
          "const": "SYNTHETIC_TEST_EVIDENCE"
        }
      }
    }
  }
}
