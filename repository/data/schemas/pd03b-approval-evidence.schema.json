{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:damavand-steel:schema:pd03b-approval-evidence:1.0.0",
  "title": "PD-03B approval evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "registry_version", "contract_version", "data_classification", "evidence"],
  "properties": {
    "registry_id": {"const": "pd03b-approval-evidence"},
    "registry_version": {"const": "1.0.0"},
    "contract_version": {"const": "1.0.0"},
    "data_classification": {"const": "CANONICAL_PD03B_EVIDENCE"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/evidence_record"}}
  },
  "$defs": {
    "hash_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "founder_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "scope", "verdict", "evidence_reference", "review_date"],
      "properties": {
        "reviewer_id": {"const": "Founder پروژه Damavand Steel"},
        "scope": {"const": "Exact PD-03B Canonical Pilot Records"},
        "verdict": {"const": "PASS"},
        "evidence_reference": {"const": "task:019fa05e-1889-79b3-8e83-9477cd1648c6"},
        "review_date": {"const": "2026-08-01"}
      }
    },
    "domain_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "source_references", "new_domain_claims_authorized", "availability_authorized", "commercial_identity_authorized"],
      "properties": {
        "basis": {"const": "FOUNDER_APPROVED_EXACT_NO_CLAIM_TUPLES"},
        "source_references": {"type": "array", "prefixItems": [{"const": "FD-PILOT-001"}, {"const": "FD-PD03A-001"}], "items": false, "minItems": 2, "maxItems": 2},
        "new_domain_claims_authorized": {"const": false},
        "availability_authorized": {"const": false},
        "commercial_identity_authorized": {"const": false}
      }
    },
    "technical_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "reviewer_id", "scope", "verdict", "evidence_reference", "independent", "review_date", "reviewed_head_sha", "reviewed_base_sha", "reviewed_commit_object_b64", "reviewed_commit_object_sha256", "ci_run_id", "ci_job_id", "verdict_artifact", "verdict_artifact_sha256"],
      "properties": {
        "review_id": {"const": "PD03B-TECH-REVIEW-001"},
        "reviewer_id": {"const": "repository-guardian-independent"},
        "scope": {"const": "PD-03B contracts, schemas, registries, validators, tests, lifecycle, exact records and allowlist"},
        "verdict": {"enum": ["PENDING", "PASS"]},
        "evidence_reference": {"type": ["string", "null"], "maxLength": 500},
        "independent": {"const": true},
        "review_date": {"type": ["string", "null"], "format": "date"},
        "reviewed_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "reviewed_base_sha": {"const": "e72c32bdb041448d34c925c969fe01a2156f9e1d"},
        "reviewed_commit_object_b64": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        "reviewed_commit_object_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "ci_run_id": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$"},
        "ci_job_id": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$"},
        "verdict_artifact": {"type": ["string", "null"], "maxLength": 500},
        "verdict_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "evidence_reference"],
      "properties": {
        "approved_by": {"type": ["string", "null"], "maxLength": 200},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "evidence_reference": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "bundle_id", "approval_evidence_id", "baseline_sha"],
      "properties": {
        "decision_id": {"const": "FD-PD03B-001"},
        "bundle_id": {"const": "pilotset:36c1085ffbe9"},
        "approval_evidence_id": {"const": "papproval:d9d7811dd4f5"},
        "baseline_sha": {"const": "e72c32bdb041448d34c925c969fe01a2156f9e1d"}
      }
    },
    "consumption_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "approval_evidence_id", "evidence_reference", "consumed_at"],
      "properties": {
        "decision_id": {"const": "FD-PD03B-001"},
        "approval_evidence_id": {"const": "papproval:d9d7811dd4f5"},
        "evidence_reference": {"const": "FD-PD03B-001"},
        "consumed_at": {"type": "string", "format": "date-time"}
      }
    },
    "anti_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce_derivation", "binding", "nonce", "consumed", "consumption_history"],
      "properties": {
        "nonce_derivation": {"const": "SHA256_FIRST_24_HEX"},
        "binding": {"$ref": "#/$defs/binding"},
        "nonce": {"const": "16da0c3947ab608ae37191a5"},
        "consumed": {"type": "boolean"},
        "consumption_history": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/consumption_event"}}
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "approval_evidence_id", "decision_id", "bundle_id", "lifecycle_status", "scope_reference", "dataset_hashes", "founder_decision", "domain_basis", "technical_review", "approval", "anti_replay", "status", "record_version"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "approval_evidence_id": {"const": "papproval:d9d7811dd4f5"},
        "decision_id": {"const": "FD-PD03B-001"},
        "bundle_id": {"const": "pilotset:36c1085ffbe9"},
        "lifecycle_status": {"enum": ["DRAFT", "REVIEW", "APPROVED"]},
        "scope_reference": {"const": "docs/PD03B_CANONICAL_PILOT_SCOPE_V1.0.md"},
        "dataset_hashes": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/hash_record"}},
        "founder_decision": {"$ref": "#/$defs/founder_decision"},
        "domain_basis": {"$ref": "#/$defs/domain_basis"},
        "technical_review": {"$ref": "#/$defs/technical_review"},
        "approval": {"$ref": "#/$defs/approval"},
        "anti_replay": {"$ref": "#/$defs/anti_replay"},
        "status": {"enum": ["CANDIDATE_UNVERIFIED", "APPROVED"]},
        "record_version": {"const": "1.0.0"}
      }
    }
  }
}
