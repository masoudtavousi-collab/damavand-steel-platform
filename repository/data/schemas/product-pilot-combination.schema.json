{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:damavand-steel:schema:product-pilot-combination:1.0.0",
  "title": "Synthetic PD-03 pilot-combination test bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "fixture_id", "data_classification", "series_entity_id", "variant_rule_set_entity_id", "profile_id", "axes", "fixed_material_term_id", "cartesian_generation_forbidden", "combinations", "readiness", "provenance"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "fixture_id": {"const": "ptest:dfa2ea0b6c2e"},
    "data_classification": {"const": "SYNTHETIC_FIXTURE"},
    "series_entity_id": {"const": "prd:series:e1657d35ac35"},
    "variant_rule_set_entity_id": {"const": "prd:variant-rule-set:eb255662accc"},
    "profile_id": {"const": "pprof:4c556c63c1a9"},
    "axes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["grade", "finish", "diameter", "thickness", "length"]}
    },
    "fixed_material_term_id": {"const": "vterm:5ff9c0ceca39"},
    "cartesian_generation_forbidden": {"const": true},
    "combinations": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/combination"}},
    "readiness": {"$ref": "#/$defs/readiness"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimal_lexeme", "unit_id"],
      "properties": {
        "decimal_lexeme": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "unit_id": {"type": "string", "pattern": "^unit:[0-9a-f]{12}$"}
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combination_id", "historical_reference", "historical_reference_is_identity", "grade_term_id", "finish_term_id", "diameter", "thickness", "length", "availability_status", "status"],
      "properties": {
        "combination_id": {"type": "string", "pattern": "^pcomb:[0-9a-f]{12}$"},
        "historical_reference": {"enum": ["PIPE-COMB-0001", "PIPE-COMB-0016", "PIPE-COMB-0023"]},
        "historical_reference_is_identity": {"const": false},
        "grade_term_id": {"const": "vterm:a891bfdfdd6b"},
        "finish_term_id": {"const": "vterm:1df9a5493546"},
        "diameter": {"$ref": "#/$defs/measure"},
        "thickness": {"$ref": "#/$defs/measure"},
        "length": {"$ref": "#/$defs/measure"},
        "availability_status": {"const": "MISSING_DATA_VALUE"},
        "status": {"const": "CANDIDATE_UNVERIFIED"}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import_ready", "runtime_ready", "golden_ready"],
      "properties": {
        "import_ready": {"const": false},
        "runtime_ready": {"const": false},
        "golden_ready": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_reference", "captured_by", "captured_at", "evidence_status"],
      "properties": {
        "source_type": {"const": "SYNTHETIC_FIXTURE"},
        "source_reference": {"const": "tests/fixtures/pd03a/valid-synthetic-pilot-combinations.yaml"},
        "captured_by": {"const": "role:codex-build-engine"},
        "captured_at": {"const": "2026-08-01T00:00:00Z"},
        "evidence_status": {"const": "SYNTHETIC_TEST_EVIDENCE"}
      }
    }
  }
}
