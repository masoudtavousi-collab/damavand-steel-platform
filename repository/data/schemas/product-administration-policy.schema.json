        "rule_purpose": {"enum": ["COMPATIBILITY", "ASSORTMENT"]},
        "directionality": {"enum": ["DIRECTIONAL", "SYMMETRIC"]},
        "component_ratios": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"$ref": "#/$defs/component_ratio"}},
        "quantity_basis": {"enum": ["PER_ASSEMBLY", "PER_LINEAR_METRE", "PER_AREA", "PER_SET"]},
        "dimension_predicates": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/dimension_predicate"}},
        "evidence_entries": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/harmony_evidence"}},
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_until": {"type": ["string", "null"], "format": "date-time"},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "conflict_references": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 160}},
        "outcome": {"enum": ["ELIGIBLE", "INELIGIBLE", "UNDETERMINED"]},
        "pricing_effect_allowed": {"const": false},
        "stock_or_availability_inference_allowed": {"const": false},
        "commerce_eligibility_effect_allowed": {"const": false},
        "status": {"const": "CANDIDATE_UNVERIFIED"},
        "owner": {"$ref": "#/$defs/owner"},
        "reviewer": {"$ref": "#/$defs/reviewer"},
        "provenance": {"$ref": "#/$defs/provenance"},
