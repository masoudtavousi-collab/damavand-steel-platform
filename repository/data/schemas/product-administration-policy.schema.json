    "component_ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_reference", "quantity_lexeme", "unit_id"],
      "properties": {
        "component_reference": {"type": "string", "pattern": "^prd:sku:[0-9a-f]{12}$"},
        "quantity_lexeme": {"type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"},
