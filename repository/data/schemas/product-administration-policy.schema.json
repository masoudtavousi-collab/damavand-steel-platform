        "reviewed_at": {"type": "string", "format": "date-time"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "inventory_harmony": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "record_id", "rule_version", "rule_purpose", "directionality", "component_ratios", "quantity_basis", "dimension_predicates", "evidence_entries", "effective_from", "effective_until", "evaluated_at", "conflict_references", "outcome", "pricing_effect_allowed", "stock_or_availability_inference_allowed", "commerce_eligibility_effect_allowed", "status", "owner", "reviewer", "provenance", "record_version"],
      "properties": {
