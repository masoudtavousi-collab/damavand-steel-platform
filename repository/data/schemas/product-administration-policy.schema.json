        "component_references": {"type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^prd:sku:[0-9a-f]{12}$"}},
        "unit_id": {"type": "string", "pattern": "^unit:[0-9a-f]{12}$"},
        "tolerance_lexeme": {"type": ["string", "null"], "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}
