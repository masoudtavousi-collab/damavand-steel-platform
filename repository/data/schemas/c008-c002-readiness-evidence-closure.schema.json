        "conflicting_count": {"const": 0},
        "stale_count": {"const": 0},
        "supplier_specific_count": {"const": 0},
        "rights_safe_media_count": {"const": 0}
      }
    },
    "criterionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_code",
        "sequence",
        "c005_state",
        "terminal_state",
        "c002_mapped_state",
        "review_lane",
        "reviewed_at",
        "evidence_ids",
        "base_evidence_refs",
        "submitter",
        "evidence_owner",
        "independent_reviewer",
        "resolved",
        "blocking",
        "remaining_requirement",
        "promotion_effect"
      ],
      "properties": {
        "criterion_code": {"$ref": "#/$defs/criterionCode"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9},
        "c005_state": {"enum": ["SUBMITTED", "MISSING"]},
        "terminal_state": {"$ref": "#/$defs/terminalState"},
        "c002_mapped_state": {"$ref": "#/$defs/c002State"},
        "review_lane": {"enum": ["LANE_A_INDEPENDENT_REVIEW", "LANE_B_SUPPLY_FULFILLMENT", "LANE_C_RIGHTS_SAFE_MEDIA", "LANE_D_CONDITIONAL_SEO"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"pattern": "^C008-EVID-00[1-9]$"}, "uniqueItems": true},
        "base_evidence_refs": {"$ref": "#/$defs/stringArray"},
        "submitter": {"const": "FOUNDER_AND_CANONICAL_REPOSITORY_SOURCES"},
        "evidence_owner": {"const": "C002_EVIDENCE_INTAKE"},
        "independent_reviewer": {"const": "INDEPENDENT_C008_EVIDENCE_REVIEWER"},
        "resolved": {"type": "boolean"},
        "blocking": {"type": "boolean"},
        "remaining_requirement": {"type": ["string", "null"], "minLength": 1},
        "promotion_effect": {"const": false}
      }
    },
    "readinessResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_count",
        "verified_count",
        "not_applicable_approved_count",
        "submitted_review_incomplete_count",
        "missing_evidence_count",
        "conflicting_evidence_count",
        "expired_or_stale_evidence_count",
        "resolved_count",
        "unresolved_count",
        "open_blocking_count",
        "readiness",
        "founder_selection_ready",
        "candidate_registry_count"
      ],
      "properties": {
        "criterion_count": {"const": 9},
        "verified_count": {"const": 4},
        "not_applicable_approved_count": {"const": 0},
        "submitted_review_incomplete_count": {"const": 4},
        "missing_evidence_count": {"const": 1},
        "conflicting_evidence_count": {"const": 0},
        "expired_or_stale_evidence_count": {"const": 0},
        "resolved_count": {"const": 4},
        "unresolved_count": {"const": 5},
        "open_blocking_count": {"const": 5},
        "readiness": {"const": "NOT_READY"},
        "founder_selection_ready": {"const": false},
        "candidate_registry_count": {"const": 0}
      }
    },
    "g1DecisionSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "resolved_criteria",
        "unresolved_criteria",
        "missing_evidence",
        "conflicts",
        "founder_selection_ready",
        "m4_promotion_candidate",
        "recommendation_is_selection",
        "founder_decision_required",
        "m4_authorized"
      ],
      "properties": {
        "result": {"const": "HOLD_NOT_READY_4_OF_9"},
        "resolved_criteria": {"$ref": "#/$defs/stringArray"},
        "unresolved_criteria": {"$ref": "#/$defs/stringArray"},
        "missing_evidence": {"$ref": "#/$defs/stringArray"},
        "conflicts": {"$ref": "#/$defs/stringArray"},
        "founder_selection_ready": {"const": false},
        "m4_promotion_candidate": {"type": "null"},
        "recommendation_is_selection": {"const": false},
        "founder_decision_required": {"const": "HOLD_M4_AND_REQUEST_REMAINING_REAL_WORLD_EVIDENCE"},
        "m4_authorized": {"const": false}
      }
    },
    "regressionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c002_candidate_count",
        "c002_policy_count",
        "c002_policy_instance_count",
        "c005_source_count",
        "c005_evidence_record_count",
        "c005_submitted_count",
        "c005_missing_count",
        "c005_reviewable_count",
        "c005_resolved_count",
        "c005_open_blocking_count",
        "c003_r3_confirmed_valid_evidence_count",
        "canonical_product_entity_count",
        "canonical_sku_count",
        "current_numeric_mass_observation_count",
        "current_supply_intake_record_count",
        "current_price_value_count",
        "customer_object_count",
        "order_object_count",
        "active_vip_entitlement_count",
        "active_loyalty_ledger_count",
        "commerce_state",
        "runtime_authority",
        "production_authority",
        "c1_t03_state"
      ],
      "properties": {
        "c002_candidate_count": {"const": 0},
        "c002_policy_count": {"const": 8},
        "c002_policy_instance_count": {"const": 0},
        "c005_source_count": {"const": 5},
        "c005_evidence_record_count": {"const": 17},
        "c005_submitted_count": {"const": 8},
        "c005_missing_count": {"const": 1},
        "c005_reviewable_count": {"const": 6},
        "c005_resolved_count": {"const": 0},
        "c005_open_blocking_count": {"const": 9},
        "c003_r3_confirmed_valid_evidence_count": {"const": 216},
        "canonical_product_entity_count": {"const": 3},
        "canonical_sku_count": {"const": 0},
        "current_numeric_mass_observation_count": {"const": 0},
        "current_supply_intake_record_count": {"const": 0},
        "current_price_value_count": {"const": 0},
        "customer_object_count": {"const": 0},
        "order_object_count": {"const": 0},
        "active_vip_entitlement_count": {"const": 0},
        "active_loyalty_ledger_count": {"const": 0},
        "commerce_state": {"const": "INQUIRY_ONLY"},
        "runtime_authority": {"const": "NONE"},
