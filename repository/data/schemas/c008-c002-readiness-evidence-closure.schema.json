{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.damavandsteel.local/c008-c002-readiness-evidence-closure.schema.json",
  "title": "C008 C002 Readiness Evidence Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data_classification",
    "fixture_mode",
    "registry_version",
    "mission_id",
    "packet",
    "starting_main_sha",
    "evaluation_as_of",
    "authority_effects",
    "source_manifest",
    "evidence_items",
    "evidence_summary",
    "criterion_reviews",
    "readiness_result",
    "g1_decision_surface",
    "regression_snapshot"
  ],
  "properties": {
    "data_classification": {"const": "C008_C002_READINESS_EVIDENCE_CLOSURE"},
    "fixture_mode": {"enum": ["CANONICAL", "SYNTHETIC"]},
    "registry_version": {"const": "1.0.0"},
    "mission_id": {"const": "C008"},
    "packet": {"$ref": "#/$defs/packet"},
    "starting_main_sha": {"const": "5a6fcbf368f817e88fca070a111fecbe65c4511a"},
    "evaluation_as_of": {"type": "string", "format": "date-time"},
    "authority_effects": {"$ref": "#/$defs/authorityEffects"},
    "source_manifest": {"$ref": "#/$defs/sourceManifest"},
    "evidence_items": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/evidenceItem"}
    },
    "evidence_summary": {"$ref": "#/$defs/evidenceSummary"},
    "criterion_reviews": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/criterionReview"}
    },
    "readiness_result": {"$ref": "#/$defs/readinessResult"},
    "g1_decision_surface": {"$ref": "#/$defs/g1DecisionSurface"},
    "regression_snapshot": {"$ref": "#/$defs/regressionSnapshot"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "maxLength": 2000},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "criterionCode": {
      "enum": [
        "DEMAND_SIGNAL",
        "SUPPLY_EVIDENCE",
        "GROSS_PROFIT_POTENTIAL",
        "REPEATABILITY",
        "PRODUCT_DATA_COMPLETENESS",
        "PHOTO_CONTENT_READINESS",
        "SEO_BUYER_INTENT",
        "OPERATIONAL_COMPLEXITY",
        "FULFILLMENT_RISK"
      ]
    },
    "terminalState": {
      "enum": [
        "VERIFIED",
        "NOT_APPLICABLE_APPROVED",
        "SUBMITTED_REVIEW_INCOMPLETE",
        "MISSING_EVIDENCE",
        "CONFLICTING_EVIDENCE",
        "EXPIRED_OR_STALE_EVIDENCE"
      ]
    },
    "c002State": {
      "enum": ["MISSING", "SUBMITTED", "VERIFIED", "CONFLICTING", "EXPIRED", "NOT_APPLICABLE_APPROVED"]
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_version",
        "slack_channel_id",
        "authorization_parent_ts",
        "packet_reply_ts",
        "slack_file_id",
        "packet_zip_sha256",
        "thread_complete",
        "reply_count"
      ],
      "properties": {
        "packet_id": {"const": "DS-P1-M3-PACKET-01"},
        "packet_version": {"const": "1.0"},
        "slack_channel_id": {"const": "C0BNHRRTE9F"},
        "authorization_parent_ts": {"const": "1787343117.499159"},
        "packet_reply_ts": {"const": "1787343126.534289"},
        "slack_file_id": {"const": "F0BRTDC1LH3"},
        "packet_zip_sha256": {"const": "4298addbde0c12cc6f4c4653ab5a33b3f6f17c69c485dd01a7581c98981591e5"},
        "thread_complete": {"const": true},
        "reply_count": {"const": 1}
      }
    },
    "authorityEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_intake_and_normalization",
        "independent_c002_review",
        "g1_decision_surface",
        "candidate_population",
        "product_population",
        "controlled_value_promotion",
        "valid_tuple_promotion",
        "sku_assignment",
        "mass_population",
        "supply_truth_population",
        "availability_or_stock_claim",
        "price_or_pricing_authority",
        "commerce_eligibility_population",
        "customer_lead_order_payment_population",
        "media_publication",
        "seo_publication",
        "wordpress_woocommerce_mutation",
        "runtime_staging_production",
        "deployment_import_hosting_database",
        "workflow_secret_repository_settings_mutation",
        "m4_start",
        "successor_mission",
        "auto_merge",
        "merge"
      ],
      "properties": {
        "evidence_intake_and_normalization": {"const": true},
        "independent_c002_review": {"const": true},
        "g1_decision_surface": {"const": true},
        "candidate_population": {"const": false},
        "product_population": {"const": false},
        "controlled_value_promotion": {"const": false},
        "valid_tuple_promotion": {"const": false},
        "sku_assignment": {"const": false},
        "mass_population": {"const": false},
        "supply_truth_population": {"const": false},
        "availability_or_stock_claim": {"const": false},
        "price_or_pricing_authority": {"const": false},
        "commerce_eligibility_population": {"const": false},
        "customer_lead_order_payment_population": {"const": false},
        "media_publication": {"const": false},
        "seo_publication": {"const": false},
        "wordpress_woocommerce_mutation": {"const": false},
        "runtime_staging_production": {"const": false},
        "deployment_import_hosting_database": {"const": false},
        "workflow_secret_repository_settings_mutation": {"const": false},
        "m4_start": {"const": false},
        "successor_mission": {"const": false},
        "auto_merge": {"const": false},
        "merge": {"const": false}
      }
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_count", "sources"],
      "properties": {
        "source_count": {"const": 2},
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_role", "source_locator", "captured_at", "title", "author_id", "thread_complete"],
      "properties": {
        "source_id": {"pattern": "^C008-SOURCE-00[1-4]$"},
        "source_role": {"enum": ["EXECUTION_AUTHORIZATION", "PACKET", "PUBLIC_RESEARCH"]},
        "source_locator": {"$ref": "#/$defs/nonEmptyString"},
        "captured_at": {"type": "string", "format": "date-time"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "author_id": {"$ref": "#/$defs/nonEmptyString"},
        "thread_complete": {"type": "boolean"}
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "sequence",
        "criterion_code",
        "evidence_class",
        "temporal_role",
        "source_locators",
        "captured_at",
        "exact_subject",
        "confidentiality",
        "owner",
        "reviewer",
        "valid_from",
        "valid_until",
        "freshness_rule",
        "freshness_status",
        "supported_claims",
        "unsupported_claims",
        "conflicts",
        "base_evidence_refs",
        "protected_locator",
        "promotion_effect",
        "implementation_authority"
      ],
      "properties": {
        "evidence_id": {"pattern": "^C008-EVID-00[1-9]$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9},
        "criterion_code": {"$ref": "#/$defs/criterionCode"},
        "evidence_class": {
          "enum": [
            "REPOSITORY_CANONICAL_EVIDENCE",
            "FOUNDER_CONFIRMED_EVIDENCE",
            "SUPPLIER_SPECIFIC_EVIDENCE",
            "RIGHTS_SAFE_MEDIA_EVIDENCE",
            "PUBLIC_RESEARCH_EVIDENCE",
            "PROTECTED_COMMERCIAL_EVIDENCE",
            "MISSING_EVIDENCE",
            "CONFLICTING_EVIDENCE"
          ]
        },
        "temporal_role": {"enum": ["CURRENT_REVIEW", "CURRENT_GAP", "CURRENT_PUBLIC_OBSERVATION"]},
        "source_locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
        "captured_at": {"type": "string", "format": "date-time"},
        "exact_subject": {"$ref": "#/$defs/nonEmptyString"},
        "confidentiality": {"enum": ["PUBLIC", "INTERNAL", "PROTECTED_LOCATOR_ONLY"]},
        "owner": {"enum": ["C002_EVIDENCE_INTAKE", "C008_EVIDENCE_CLOSURE"]},
        "reviewer": {"const": "INDEPENDENT_C008_EVIDENCE_REVIEWER"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "freshness_rule": {"$ref": "#/$defs/nonEmptyString"},
        "freshness_status": {"enum": ["CURRENT", "MISSING"]},
        "supported_claims": {"$ref": "#/$defs/stringArray"},
        "unsupported_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
        "conflicts": {"$ref": "#/$defs/stringArray"},
        "base_evidence_refs": {"$ref": "#/$defs/stringArray"},
        "protected_locator": {
          "oneOf": [
            {"type": "string", "pattern": "^protected-evidence:[A-Za-z0-9._:/-]+$"},
            {"type": "null"}
          ]
        },
        "promotion_effect": {"const": false},
        "implementation_authority": {"const": false}
      }
    },
    "evidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "by_class",
        "protected_count",
        "conflicting_count",
        "stale_count",
        "supplier_specific_count",
        "rights_safe_media_count"
      ],
      "properties": {
        "total": {"const": 9},
        "by_class": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "REPOSITORY_CANONICAL_EVIDENCE",
            "FOUNDER_CONFIRMED_EVIDENCE",
            "SUPPLIER_SPECIFIC_EVIDENCE",
            "RIGHTS_SAFE_MEDIA_EVIDENCE",
            "PUBLIC_RESEARCH_EVIDENCE",
            "PROTECTED_COMMERCIAL_EVIDENCE",
            "MISSING_EVIDENCE",
            "CONFLICTING_EVIDENCE"
          ],
          "properties": {
            "REPOSITORY_CANONICAL_EVIDENCE": {"const": 4},
            "FOUNDER_CONFIRMED_EVIDENCE": {"const": 2},
            "SUPPLIER_SPECIFIC_EVIDENCE": {"const": 0},
            "RIGHTS_SAFE_MEDIA_EVIDENCE": {"const": 0},
            "PUBLIC_RESEARCH_EVIDENCE": {"const": 0},
            "PROTECTED_COMMERCIAL_EVIDENCE": {"const": 0},
            "MISSING_EVIDENCE": {"const": 3},
            "CONFLICTING_EVIDENCE": {"const": 0}
          }
