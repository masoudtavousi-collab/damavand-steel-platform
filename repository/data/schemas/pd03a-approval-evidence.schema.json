{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:damavand-steel:schema:pd03a-approval-evidence:1.0.0",
  "title": "PD-03A approval evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "registry_version", "contract_version", "data_classification", "evidence"],
  "properties": {
    "registry_id": {"const": "pd03a-approval-evidence"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contract_version": {"const": "1.0.0"},
    "data_classification": {"const": "CANONICAL_PD03A_EVIDENCE"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/evidence_record"}}
  },
  "$defs": {
    "hash_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "failed_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "scope", "verdict", "evidence_reference", "independent", "review_date"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "scope": {"type": "string", "minLength": 1, "maxLength": 500},
        "verdict": {"enum": ["PASS", "PENDING", "BLOCKED_REVIEWER_INELIGIBLE", "BLOCKED_REVIEWER_INCOMPLETE"]},
        "evidence_reference": {"type": ["string", "null"], "maxLength": 500},
        "independent": {"type": "boolean"},
        "review_date": {"type": ["string", "null"], "format": "date"}
      }
    },
    "technical_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "reviewer_id", "scope", "verdict", "evidence_reference", "independent", "review_date", "reviewed_head_sha", "reviewed_base_sha", "verdict_artifact", "verdict_artifact_sha256"],
      "properties": {
        "review_id": {"const": "PD03A-TECH-REVIEW-001"},
        "reviewer_id": {"const": "repository-guardian-independent"},
        "scope": {"const": "PD-03A contracts, schemas, validators, tests, extension integrity, lifecycle and exact allowlist"},
        "verdict": {"enum": ["PASS", "PENDING"]},
        "evidence_reference": {"type": ["string", "null"], "maxLength": 500},
        "independent": {"const": true},
        "review_date": {"type": ["string", "null"], "format": "date"},
        "reviewed_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "reviewed_base_sha": {"const": "dd4d4e9dde59ce652edb5b99d2df3e84b56b8031"},
        "verdict_artifact": {"type": ["string", "null"], "maxLength": 500},
        "verdict_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "founder_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "scope", "verdict", "evidence_reference", "independent", "review_date"],
      "properties": {
        "reviewer_id": {"const": "Founder پروژه Damavand Steel"},
        "scope": {"const": "Exact PD-03A Pilot Prerequisite Foundation"},
        "verdict": {"const": "PASS"},
        "evidence_reference": {"const": "task:019fa05e-1889-79b3-8e83-9477cd1648c6"},
        "independent": {"const": false},
        "review_date": {"type": "string", "format": "date"}
      }
    },
    "domain_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "human_pass_claimed", "technical_claims_authorized", "commercial_claims_authorized", "source_reference"],
      "properties": {
        "basis": {"const": "FOUNDER_APPROVED_NO_CLAIM_PILOT_REFERENCES"},
        "human_pass_claimed": {"const": false},
        "technical_claims_authorized": {"const": false},
        "commercial_claims_authorized": {"const": false},
        "source_reference": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "evidence_reference"],
      "properties": {
        "approved_by": {"type": ["string", "null"], "maxLength": 200},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "evidence_reference": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "anti_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce_derivation", "binding", "nonce", "consumed", "consumption_history"],
      "properties": {
        "nonce_derivation": {"const": "SHA256_FIRST_24_HEX"},
        "binding": {"$ref": "#/$defs/anti_replay_binding"},
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "consumed": {"type": "boolean"},
        "consumption_history": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/consumption_event"}}
      }
    },
    "anti_replay_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "extension_id", "approval_evidence_id", "baseline_sha"],
      "properties": {
        "decision_id": {"const": "FD-PD03A-001"},
        "extension_id": {"const": "pdext:ad46d9948af1"},
        "approval_evidence_id": {"const": "papproval:50ba27766106"},
        "baseline_sha": {"const": "dd4d4e9dde59ce652edb5b99d2df3e84b56b8031"}
      }
    },
    "consumption_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "approval_evidence_id", "evidence_reference", "consumed_at"],
      "properties": {
        "decision_id": {"const": "FD-PD03A-001"},
        "approval_evidence_id": {"const": "papproval:50ba27766106"},
        "evidence_reference": {"const": "FD-PD03A-001"},
        "consumed_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "approval_evidence_id", "decision_id", "lifecycle_status", "scope_reference", "dataset_hashes", "founder_decision", "failed_review_attempts", "domain_basis", "technical_review", "approval", "anti_replay", "status", "record_version"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "approval_evidence_id": {"type": "string", "pattern": "^papproval:[0-9a-f]{12}$"},
        "decision_id": {"const": "FD-PD03A-001"},
        "lifecycle_status": {"enum": ["DRAFT", "REVIEW", "APPROVED"]},
        "scope_reference": {"const": "docs/PD03A_PILOT_PREREQUISITE_FOUNDATION_SCOPE_V1.0.md"},
        "dataset_hashes": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/hash_record"}},
        "founder_decision": {"$ref": "#/$defs/founder_decision"},
        "failed_review_attempts": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"$ref": "#/$defs/failed_review"}},
        "domain_basis": {"$ref": "#/$defs/domain_basis"},
        "technical_review": {"$ref": "#/$defs/technical_review"},
        "approval": {"$ref": "#/$defs/approval"},
        "anti_replay": {"$ref": "#/$defs/anti_replay"},
        "status": {"enum": ["CANDIDATE_UNVERIFIED", "APPROVED"]},
        "record_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    }
  }
}
