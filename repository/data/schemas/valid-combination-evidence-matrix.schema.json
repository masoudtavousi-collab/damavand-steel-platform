      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "thickness_mm", "appearance", "length_m"],
      "properties": {
        "brand": {"$ref": "#/$defs/brand"},
        "thickness_mm": {"$ref": "#/$defs/thickness"},
        "appearance": {"$ref": "#/$defs/appearance"},
        "length_m": {"enum": ["3.00", "6.00"]}
      }
    },
    "supplyTupleScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "tuples", "omitted_tuple_state", "cartesian_generation_allowed"],
      "properties": {
        "representation": {"const": "EXACT_TUPLE_LIST"},
        "tuples": {"type": "array", "minItems": 1, "maxItems": 216, "uniqueItems": true, "items": {"$ref": "#/$defs/exactSupplyTuple"}},
        "omitted_tuple_state": {"const": "UNKNOWN"},
        "cartesian_generation_allowed": {"const": false}
      }
    },
    "supplyEvidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supply_evidence_id", "supplier_or_source", "confirmation_channel", "confirmation_timestamp", "valid_from", "valid_until", "tuple_scope", "evidence_source_locator", "evidence_classification", "temporal_role", "reviewer_reference", "reviewed_at", "evidence_status", "availability_effect", "stock_effect"],
      "properties": {
        "supply_evidence_id": {"type": "string", "pattern": "^c003r2supply:[0-9a-f]{12}$"},
        "supplier_or_source": {"type": "string", "minLength": 3, "maxLength": 200},
        "confirmation_channel": {"enum": ["TELEPHONE", "WHATSAPP", "EMAIL", "DOCUMENT", "OTHER_GOVERNED_CHANNEL"]},
        "confirmation_timestamp": {"type": "string", "format": "date-time"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "tuple_scope": {"$ref": "#/$defs/supplyTupleScope"},
        "evidence_source_locator": {"type": "string", "minLength": 8, "maxLength": 300},
        "evidence_classification": {"enum": ["SUPPLIER_DOCUMENT", "OPERATIONS_EVIDENCE"]},
        "temporal_role": {"enum": ["CURRENT_OBSERVATION", "HISTORICAL_NONCURRENT"]},
        "reviewer_reference": {"type": "string", "minLength": 3, "maxLength": 160},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "evidence_status": {"enum": ["SUBMITTED", "VERIFIED", "EXPIRED", "CONFLICTING", "REJECTED"]},
        "availability_effect": {"const": false},
        "stock_effect": {"const": false}
      }
    },
    "supplyIntake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure_status", "population_authority", "required_fields", "records", "supply_evidence_record_count", "creates_availability", "creates_stock_claim"],
      "properties": {
        "structure_status": {"const": "PREPARED_EMPTY"},
        "population_authority": {"const": false},
        "required_fields": {"const": ["supply_evidence_id", "supplier_or_source", "confirmation_channel", "confirmation_timestamp", "valid_from", "valid_until", "tuple_scope", "evidence_source_locator", "evidence_classification", "temporal_role", "reviewer_reference", "reviewed_at", "evidence_status", "availability_effect", "stock_effect"]},
        "records": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/supplyEvidenceRecord"}},
        "supply_evidence_record_count": {"const": 0},
        "creates_availability": {"const": false},
        "creates_stock_claim": {"const": false}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_order", "criterion_states", "resolved_count", "unresolved_count", "coverage", "readiness", "founder_selection_recorded"],
      "properties": {
        "criterion_order": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/criterionCode"}},
        "criterion_states": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"enum": ["MISSING", "SUBMITTED"]}},
        "resolved_count": {"const": 0},
        "unresolved_count": {"const": 9},
        "coverage": {"const": "0/9"},
        "readiness": {"const": "NOT_READY"},
        "founder_selection_recorded": {"const": false}
      }
    },
    "selectionEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_registry_population", "product_state", "sku_state", "availability_state", "price_state", "commerce_state", "runtime_state", "production_state"],
      "properties": {
        "candidate_registry_population": {"const": false},
        "product_state": {"const": "NOT_CREATED"},
        "sku_state": {"const": "NOT_ASSIGNED"},
        "availability_state": {"const": "NOT_ASSERTED"},
        "price_state": {"const": "NO_CURRENT_OR_PUBLIC_PRICE_FACT"},
        "commerce_state": {"const": "INQUIRY_ONLY"},
        "runtime_state": {"const": "NONE"},
        "production_state": {"const": "NONE"}
      }
    }
  }
}
