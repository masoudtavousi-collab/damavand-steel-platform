            "properties": {
              "code": {
                "type": "string",
                "const": "430"
              },
              "disposition": {
                "type": "string",
                "const": "DEFERRED"
              }
            }
          }
        },
        "base_lengths_m": {
          "type": "array",
          "const": [
            3,
            6
          ]
