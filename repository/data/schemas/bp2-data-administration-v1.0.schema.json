    "stop_conditions": {
      "type": "array",
      "const": [
        "ADMIN_UI_IMPLEMENTATION",
        "PRODUCT_OR_SKU_MUTATION",
        "WORDPRESS_OR_WOOCOMMERCE_CHANGE",
        "DATA_IMPORT",
        "PUBLICATION",
        "DEPLOYMENT",
        "CANDIDATE_PROMOTION",
        "SCOPE_EXPANSION"
      ]
