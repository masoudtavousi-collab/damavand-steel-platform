        "CATALOG",
        "PLATFORM",
        "FAMILY",
        "SERIES",
        "VARIANT_RULE_SET",
        "SKU"
      ]
    },
    "status_vocabulary": {
      "type": "array",
      "const": [
        "APPROVED",
        "CANDIDATE_UNVERIFIED",
        "MISSING_DATA_VALUE",
        "FOUNDER_INPUT_REQUIRED",
        "DEFERRED",
        "NOT_APPLICABLE",
        "INVALID"
      ]
    },
    "registries": {
      "type": "array",
      "const": [
        "MATERIAL",
        "GRADE",
        "DIAMETER_SIZE",
        "THICKNESS",
        "COLOR_FINISH",
        "SURFACE_DESIGN",
        "BRANCH_LENGTH",
        "SALES_CALCULATION_UNITS",
        "SUPPLY_STATUS",
        "VALID_COMBINATION_RULES",
        "PILOT_COMBINATIONS",
        "PROVENANCE_EVIDENCE"
