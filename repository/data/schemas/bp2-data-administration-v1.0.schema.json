      "properties": {
        "source_type": {
          "type": "string",
          "const": "FOUNDER_DECISIONS"
        },
        "source_reference": {
          "type": "string",
          "const": "BP2 Data Administration Scope v1.0 authorization"
        },
        "captured_by": {
          "type": "string",
          "const": "role:project-governance"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "const": "2026-07-23T00:00:00Z"
        },
        "evidence_status": {
          "type": "string",
          "const": "APPROVED"
