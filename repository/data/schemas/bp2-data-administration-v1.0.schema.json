        "free_text_inquiry_allowed",
        "auto_creates_master_data",
        "auto_creates_product",
        "auto_creates_sku"
      ],
      "properties": {
        "approved_combination_selectable": {
          "type": "boolean",
          "const": true
        },
        "candidate_selectable": {
          "type": "boolean",
          "const": false
        },
        "candidate_auto_promotion": {
          "type": "boolean",
          "const": false
        },
        "free_text_inquiry_allowed": {
          "type": "boolean",
          "const": true
        },
        "auto_creates_master_data": {
          "type": "boolean",
          "const": false
        },
        "auto_creates_product": {
          "type": "boolean",
          "const": false
        },
        "auto_creates_sku": {
          "type": "boolean",
          "const": false
        }
      }
