        "documentation_only": {
          "type": "boolean",
          "const": true
        },
        "implements_admin_ui": {
          "type": "boolean",
          "const": false
        },
        "creates_products": {
          "type": "boolean",
          "const": false
        },
        "creates_skus": {
          "type": "boolean",
          "const": false
        },
        "changes_wordpress": {
          "type": "boolean",
          "const": false
        },
        "allows_import": {
          "type": "boolean",
          "const": false
        },
        "allows_publication": {
          "type": "boolean",
          "const": false
        },
        "allows_deployment": {
          "type": "boolean",
          "const": false
        }
      }
    },
