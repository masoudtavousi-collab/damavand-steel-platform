      "properties": {
        "locale": {
          "type": "string",
          "const": "fa-IR"
        },
        "direction": {
          "type": "string",
          "const": "RTL"
        },
        "mobile_first": {
          "type": "boolean",
          "const": true
        },
        "components": {
          "type": "array",
          "const": [
            "REGISTRY_COUNTS",
            "STATUS_FILTERS",
            "SEARCH",
            "ADD_EDIT_ARCHIVE",
            "DEPENDENCY_PREVIEW",
            "COMBINATION_PREVIEW",
            "AUDIT_LOG",
            "FOUNDER_APPROVAL_QUEUE"
          ]
        },
        "implementation_authority": {
          "type": "boolean",
          "const": false
        }
      }
