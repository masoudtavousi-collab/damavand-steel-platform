        "thickness_in_category": {
          "type": "boolean",
          "const": false
        },
        "cartesian_generation_forbidden": {
          "type": "boolean",
          "const": true
        },
        "approved_pilot_count": {
          "type": "integer",
          "const": 3
        },
        "candidate_count": {
          "type": "integer",
          "const": 879
        },
        "aluminum_and_iron_thickness": {
          "type": "string",
          "const": "NOT_APPLICABLE"
        },
        "sheet_administration": {
          "type": "string",
          "const": "DEFERRED"
        }
      }
