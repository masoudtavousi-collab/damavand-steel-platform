        "excluded_grades": {
          "type": "array",
          "const": [
            {
              "code": "430",
              "disposition": "DEFERRED"
            }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "disposition"
