        "approval_authority": {
          "type": "string",
          "const": "FOUNDER"
        },
        "implementation_authority": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "documentation_only",
        "implements_admin_ui",
        "creates_products",
        "creates_skus",
        "changes_wordpress",
        "allows_import",
        "allows_publication",
        "allows_deployment"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "const": "BP2"
