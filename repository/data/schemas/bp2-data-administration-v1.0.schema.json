        "custom_length": {
          "type": "string",
          "const": "INQUIRY_ONLY"
        },
        "sales_and_inquiry_unit": {
          "type": "string",
          "const": "BRANCH"
        },
        "calculation_unit": {
          "type": "string",
          "const": "METER"
