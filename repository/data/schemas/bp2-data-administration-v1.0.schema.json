{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:damavand-steel:schema:bp2-data-administration:1.0.0",
  "title": "BP2 Data Administration Contract v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "lifecycle",
    "scope",
    "source_contract",
    "canonical_hierarchy",
    "status_vocabulary",
    "registries",
    "registry_capabilities",
    "governance",
