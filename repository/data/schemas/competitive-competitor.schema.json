{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:damavand:c004:competitive-competitor:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_classification", "registry_version", "mission_id", "observed_at", "authority_effects", "competitors"],
  "properties": {
    "data_classification": {"const": "C004_COMPETITOR_OBSERVATIONS"},
    "registry_version": {"const": "1.0.0"},
    "mission_id": {"const": "C004"},
    "observed_at": {"type": "string", "format": "date"},
    "authority_effects": {"$ref": "#/$defs/authorityEffects"},
    "competitors": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/competitor"}}
  },
  "$defs": {
    "authorityEffects": {
      "type": "object", "additionalProperties": false,
      "required": ["product_population", "sku_population", "availability_population", "current_or_public_price", "commerce_activation", "runtime", "wordpress_woocommerce_mutation", "deployment", "production", "successor_mission"],
      "properties": {
        "product_population": {"const": false}, "sku_population": {"const": false}, "availability_population": {"const": false},
        "current_or_public_price": {"const": false}, "commerce_activation": {"const": false}, "runtime": {"const": false},
        "wordpress_woocommerce_mutation": {"const": false}, "deployment": {"const": false}, "production": {"const": false},
        "successor_mission": {"const": false}
      }
    },
    "competitor": {
      "type": "object", "additionalProperties": false,
      "required": ["competitor_id", "competitor_name", "domain", "competitor_tier", "verification_status", "confidence", "evidence_classification", "observations", "patterns"],
      "properties": {
        "competitor_id": {"type": "string", "pattern": "^comp:[0-9a-f]{12}$"},
        "competitor_name": {"type": "string", "minLength": 2, "maxLength": 80},
        "domain": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+/?$", "maxLength": 200},
        "competitor_tier": {"enum": ["TIER_1", "TIER_2", "TIER_3"]},
        "verification_status": {"enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED"]},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "evidence_classification": {"const": "EXTERNAL_OBSERVATION"},
        "observations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/observation"}},
        "patterns": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/pattern"}}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "competitor_id", "competitor_name", "domain", "competitor_tier", "observed_capability", "observation_domain", "score_dimensions", "evidence_locator", "observation_date", "evidence_status", "confidence", "strategic_relevance", "notes", "copyright_capture"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^cobs:[0-9a-f]{12}$"},
        "competitor_id": {"type": "string", "pattern": "^comp:[0-9a-f]{12}$"},
        "competitor_name": {"type": "string", "minLength": 2, "maxLength": 80},
        "domain": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+/?$", "maxLength": 200},
        "competitor_tier": {"enum": ["TIER_1", "TIER_2", "TIER_3"]},
        "observed_capability": {"type": "string", "minLength": 4, "maxLength": 240},
        "observation_domain": {"enum": ["TAXONOMY", "PRODUCT_DATA", "PRODUCT_DISCOVERY", "NAVIGATION", "SEARCH", "FILTERING", "PRODUCT_PAGE", "VARIANT_SELECTION", "PRICING_PRESENTATION", "INQUIRY", "COMMERCE", "AVAILABILITY_PRESENTATION", "CONTENT", "SEO", "TECHNICAL_KNOWLEDGE", "CALCULATORS", "RELATED_PRODUCTS", "TRUST", "CRM", "MOBILE", "RTL", "PERFORMANCE_PATTERN", "FITTINGS_DEPTH", "ADMIN_MAINTAINABILITY", "OTHER"]},
        "score_dimensions": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{3,63}$"}},
        "evidence_locator": {"type": "string", "pattern": "^https://", "maxLength": 500},
        "observation_date": {"type": "string", "format": "date"},
        "evidence_status": {"enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "STALE", "NOT_APPLICABLE"]},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "strategic_relevance": {"type": "string", "minLength": 4, "maxLength": 280},
        "notes": {"type": "string", "minLength": 4, "maxLength": 500},
        "copyright_capture": {"const": "ABSTRACTED_FEATURE_PRESENCE_ONLY"}
      }
    },
    "pattern": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern_id", "observation_refs", "pattern", "classification", "rationale"],
      "properties": {
        "pattern_id": {"type": "string", "pattern": "^cpat:[0-9a-f]{12}$"},
        "observation_refs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^cobs:[0-9a-f]{12}$"}},
        "pattern": {"type": "string", "minLength": 4, "maxLength": 240},
        "classification": {"enum": ["ADOPT_PRINCIPLE", "ADAPT", "WATCH", "AVOID", "NOT_RELEVANT"]},
        "rationale": {"type": "string", "minLength": 4, "maxLength": 400}
      }
    }
  }
}
